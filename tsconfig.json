{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,

    "noEmit": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  // Type-checked only: tsdown bundles the client, vitest and tsx read the
  // sources. The two config files are listed because they are not under src.
  "include": [
    "packages/*/src/**/*",
    "packages/collector/scripts/**/*",
    "packages/cli/tsdown.config.ts",
    "vitest.config.ts"
  ]
}
